{
	"name": "gentle-dot",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "pnpm --filter @gentle-dot/ui build && node packages/daemon/src/cli.ts",
		"build": "pnpm --filter @gentle-dot/ui build",
		"package:runtime": "node scripts/package/stage-runtime.mjs",
		"start": "node packages/daemon/src/cli.ts",
		"test": "vitest run",
		"e2e": "playwright test",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test:real": "GENTLE_DOT_REAL_AGENT=1 vitest run packages/daemon/test/real-agent.test.ts",
		"package:mac": "node scripts/package/package-mac.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
