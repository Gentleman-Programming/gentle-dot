{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the Dot and panel UI may call: event listening, Dot dragging, opening web pages (sign-in), and the four shell commands.",
	"windows": ["dot", "panel"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:window:allow-start-dragging",
		"opener:default",
		"allow-connection-info",
		"allow-toggle-panel",
		"allow-hide-panel",
		"allow-set-dot-state"
	]
}
