{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the Dot and panel UI may call: event listening, Dot dragging, opening web pages (sign-in), the four shell commands, and the computer-control commands (yolo mode included: its native confirmation decides).",
	"windows": ["dot", "panel"],
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:window:allow-start-dragging",
		"opener:default",
		"allow-connection-info",
		"allow-toggle-panel",
		"allow-hide-panel",
		"allow-set-dot-state",
		"allow-computer-endpoint",
		"allow-computer-permissions",
		"allow-computer-request-permission",
		"allow-computer-stop",
		"allow-computer-status",
		"allow-computer-set-yolo"
	]
}
