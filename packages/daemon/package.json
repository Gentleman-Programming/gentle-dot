{
	"name": "@gentle-dot/daemon",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/cli.js",
	"types": "dist/cli.d.ts",
	"bin": {
		"gentle-daemon": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc",
		"build:runtime": "node scripts/build-runtime.ts",
		"build:windows-stop": "node scripts/build-windows-stop.mjs",
		"dev": "tsx watch src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src --ext .ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-mcp": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@gentle-dot/protocol": "workspace:*",
		"gentle-pi": "4.6.0",
		"jiti": "2.7.0",
		"ws": "^8.22.0",
		"yaml": "^2.5.0",
		"chokidar": "^3.6.0",
		"commander": "^12.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@types/ws": "^8.18.2",
		"typescript": "^5.5.0",
		"tsx": "^4.16.0",
		"vitest": "^5.0.3",
		"esbuild": "0.28.2",
		"eslint": "^9.8.0"
	}
}