{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noEmit": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@gentle-dot/bridges-base": ["../../bridges/base/src"],
      "@gentle-dot/protocol": ["../../protocol/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
